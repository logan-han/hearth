{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "probe": "tsx scripts/probe-model.ts",
    "test:coverage": "vitest run --coverage",
    "evals": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@langfuse/vercel-ai-sdk": "^5.11.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@upstash/qstash": "^2.11.3",
    "@vercel/functions": "^3.9.5",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.82",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "ics": "^3.12.0",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
