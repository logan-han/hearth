{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "probe": "tsx scripts/probe-model.ts",
    "test:coverage": "vitest run --coverage",
    "evals": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.65",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@langfuse/vercel-ai-sdk": "^5.13.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@upstash/qstash": "^2.12.0",
    "@vercel/functions": "^3.9.11",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.130",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "ics": "^3.12.1",
    "jose": "^6.2.12",
    "mcp-handler": "^2.2.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^7.29.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
