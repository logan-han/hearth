# Everything the dashboard manages (the LLM tiers, the integrations,
# behaviour) is read from here ONCE, the first time the deployment sees the
# setting, and copied into the dashboard's encrypted store. From then on the
# dashboard owns it: edit there, no redeploy. A later change here is never
# read, and a seeded value can be deleted from here. A value left in this file
# is imported like any other, so the few filled in below (models, behaviour)
# are the dashboard's starting values; empty lines import nothing.
#
# Only the database, TOKEN_ENC_KEY, ADMIN_EMAILS, the OAuth clients, APP_URL,
# LLM_REASONING, GEMINI_BASE_URL, the Langfuse settings
# and the eval settings are read from the environment every time; the
# dashboard cannot change them, so they stay here.

# ---- Database -------------------------------------------------------------
# Neon Postgres, added through the Vercel Marketplace, which injects these into
# the Vercel project for you. Locally, copy them from the Neon dashboard.
# The app uses the pooled URL; migrations prefer the direct one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: only production builds migrate, since a preview may share its
# database. Set 1 on the Preview environment when Neon gives each preview a
# branch of its own. Read by the build, not managed by the dashboard.
MIGRATE_PREVIEWS=

# ---- Secrets --------------------------------------------------------------
# 32 bytes for AES-256-GCM, plus the signing of sessions, MCP keys and the
# OAuth flow. Replacing it voids every MCP key. Generate with:
#   openssl rand -hex 32
TOKEN_ENC_KEY=

# ---- LLM (optional) ---------------------------------------------------------
# Only scheduled jobs need a model of Hearth's own: reminders, watches, goal
# check-ins and jobs handed to helpers. Everything a member asks for goes
# through their own MCP client. Models are tried in tier order: local, then
# OpenRouter, then Gemini. Any tier left unconfigured drops out. Every *_MODEL
# accepts a comma-separated list, tried left to right, so one tier can offer a
# fast model then a stronger one. Every model must support tool calling.
#
# Optional: the tier order, comma separated from self-hosted, gemini and
# openrouter. A tier left out is appended, never dropped. Also set on Settings,
# under Who answers.
LLM_ORDER=
#
# Optional: how hard models may think before answering (none, minimal, low,
# medium, high), sent as reasoning_effort. Leave empty for the provider default.
# Read every time, not managed by the dashboard.
LLM_REASONING=
#
# Tier 1: any OpenAI-compatible endpoint. Self-hosted wins when it is running.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Tier 2: OpenRouter. Free models cap at 50 requests/day until you buy any
# credit, then 1000. Put any :free model before paid ones so the paid slot is
# only ever a last resort; minimax/minimax-m3:free was withdrawn in Sep 2026.
# An id starting with ~ follows a family's newest model, so the next DeepSeek
# Flash takes over here without an edit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-flash-latest
# Tier 3: Google AI Studio, via its OpenAI-compatible surface.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
# Optional: a proxy that speaks the same API, for the chain and npm run probe.
# The dashboard's model list and Test still go to Google. Read every time.
GEMINI_BASE_URL=

# ---- OAuth ----------------------------------------------------------------
# Sign-in to the dashboard, and each member's mail and calendar link. One
# provider is enough to sign in with.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail and Google Calendar links. Google takes an AI agent's calls only
# through its MCP servers, and those only from a client created with "Use
# this client for an AI-powered agent" ticked, which is to do nothing else:
# so a second Google client, not the sign-in one above. See the README.
GOOGLE_AGENT_CLIENT_ID=
GOOGLE_AGENT_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Web search -----------------------------------------------------------
TAVILY_API_KEY=

# ---- Weather (optional) -----------------------------------------------------
# Free key from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ---- Money (optional) -------------------------------------------------------
# PocketSmith developer key from https://my.pocketsmith.com/security
# Read-only, and household-wide rather than per member.
POCKETSMITH_DEVELOPER_KEY=

# ---- Notion (optional) ------------------------------------------------------
# Internal integration token from https://www.notion.so/my-integrations
# The token alone sees nothing: share each page or database with the
# integration in Notion under the page's ... menu, Connections.
NOTION_TOKEN=

# ---- Jira (optional) --------------------------------------------------------
# A plain API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Use "Create API token", NOT "Create API token with scopes": a scoped token
# has to be routed through api.atlassian.com/ex/jira/{cloudId} instead, and
# 401s against the site URL below.
# The site, e.g. https://yoursite.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# The board new tasks go on when nobody says otherwise.
JIRA_PROJECT_KEY=

# ---- Tracing (optional) -----------------------------------------------------
# Langfuse keys from a project's settings. With them set, every model call is
# traced: prompt, tools, tokens, timing and the checks on each scheduled
# report. Traces carry mail and report content; LANGFUSE_RECORD_CONTENT=off
# keeps only the shape.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_RECORD_CONTENT=on
# Optional: the environment traces are filed under. Empty means Vercel's own
# (production, preview), or development off Vercel.
LANGFUSE_TRACING_ENVIRONMENT=

# ---- Scheduler ------------------------------------------------------------
# From the Upstash QStash console. Both keys are shown there, and both are
# also editable from the dashboard (Settings -> Scheduler).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: lets you POST /api/tick by hand with an x-tick-secret header.
TICK_SECRET=

# ---- Admin dashboard --------------------------------------------------------
# Who may sign in to the dashboard at the site root as an admin, comma
# separated. Any address recorded against an admin family member also
# qualifies, so this is only the bootstrap: sign in with it, add yourself and
# the family at /setup, and everyone signs in with their own address.
ADMIN_EMAILS=

# ---- App ------------------------------------------------------------------
# Public URL of the deployment. Vercel fills this in automatically if unset.
APP_URL=
TIMEZONE=Australia/Melbourne
# How scheduled reports are written. All three are also editable from the
# dashboard.
LANGUAGE=Australian English
UNITS=metric
# What Hearth calls itself in those reports. Empty means Hearth.
ASSISTANT_NAME=

# ---- Evals (optional; npm run evals only) -----------------------------------
# The judge, as provider:model. Empty means the last Gemini slot, so the judge
# is not from the family under test.
EVAL_JUDGE_MODEL=
# 1 fails the run on a low judge score instead of only reporting it.
EVAL_STRICT=
# Any value prints each draft as it is judged.
EVAL_PRINT=
