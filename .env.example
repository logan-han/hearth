# ---- Telegram -------------------------------------------------------------
# All three can be left empty and set from the dashboard instead: sign in as an
# admin and /setup walks through them (it mints the webhook secret for you).
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# Any long random string; Telegram echoes it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# The founding members, comma separated Telegram user ids. They become admins
# and can grant everyone else with /allow, so this list never has to grow.
# With this empty, only members added from the dashboard are answered.
ALLOWED_TELEGRAM_IDS=

# ---- Database -------------------------------------------------------------
# Neon Postgres, added through the Vercel Marketplace, which injects these into
# the Vercel project for you. Locally, copy them from the Neon dashboard.
# The app uses the pooled URL; migrations prefer the direct one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---- Secrets --------------------------------------------------------------
# 32 bytes for AES-256-GCM, plus JWT signing. Generate with:
#   openssl rand -hex 32
TOKEN_ENC_KEY=

# ---- LLM ------------------------------------------------------------------
# Models are tried in tier order: local, then Gemini, then OpenRouter. Any tier
# left unconfigured drops out. Every *_MODEL accepts a comma-separated list,
# tried left to right, so one tier can offer a fast model then a stronger one.
# Every model must support tool calling.
#
# Tier 1: any OpenAI-compatible endpoint. Self-hosted wins when it is running.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Tier 2: Google AI Studio, via its OpenAI-compatible surface.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
# Tier 3: OpenRouter. Free models cap at 50 requests/day until you buy any
# credit, then 1000. Put :free models before paid ones so the paid slot is only
# ever a last resort.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free,minimax/minimax-m2.7

# ---- OAuth ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Web search -----------------------------------------------------------
TAVILY_API_KEY=

# ---- Weather (optional) -----------------------------------------------------
# Free key from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ---- Money (both optional) --------------------------------------------------
# Up Bank personal access token from https://api.up.com.au/getting_started
# Read-only, and household-wide rather than per member.
UP_API_TOKEN=
# PocketSmith developer key from https://my.pocketsmith.com/security
POCKETSMITH_DEVELOPER_KEY=

# ---- Notion (optional) ------------------------------------------------------
# Internal integration token from https://www.notion.so/my-integrations
# The token alone sees nothing: share each page or database with the
# integration in Notion under the page's ... menu, Connections.
NOTION_TOKEN=

# ---- Jira (optional) --------------------------------------------------------
# A plain API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Use "Create API token", NOT "Create API token with scopes": a scoped token
# has to be routed through api.atlassian.com/ex/jira/{cloudId} instead, and
# 401s against the site URL below.
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# The board the bot adds tasks to when nobody says otherwise.
JIRA_PROJECT_KEY=

# ---- Scheduler ------------------------------------------------------------
# From the Upstash QStash console. Both keys are shown there, and both are
# also editable from the dashboard (Settings -> Scheduler).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: lets you POST /api/tick by hand with an x-tick-secret header.
TICK_SECRET=

# ---- Admin dashboard --------------------------------------------------------
# Who may sign in at /admin, comma separated. Any address already linked to an
# admin family member also qualifies, so this is only the bootstrap.
ADMIN_EMAILS=

# ---- App ------------------------------------------------------------------
# Public URL of the deployment. Vercel fills this in automatically if unset.
APP_URL=
# 'on' lets the bot decide whether to chime in on ordinary group chatter.
AMBIENT_MODE=off
TIMEZONE=Australia/Melbourne
# How the bot writes. All three are also editable from the dashboard.
LANGUAGE=Australian English
UNITS=metric
